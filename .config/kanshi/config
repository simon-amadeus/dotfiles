profile home {
    output HDMI-A-1 mode 3840x2160 position 0,0 scale 1.5
    output eDP-1 mode 3840x2160 position 2560,640 scale 2
}

profile home_dock {
    output DP-1 mode 3840x2160 position 0,0 scale 1.5
    output eDP-1 mode 3840x2160 position 2560,640 scale 2
}

profile default {
    output eDP-1 mode 3840x2160 position 0,0 scale 2
}

