// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "cli_default_open_behavior": "existing_window",
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "git_panel": {
    "dock": "left"
  },
  "buffer_font_weight": 400.0,
  "icon_theme": "Material Icon Theme",
  "agent": {
    "dock": "right",
    "model_parameters": [],
    "default_model": {
      "provider": "copilot_chat",
      "model": "o3-mini",
    },
  },
  "ui_font_size": 16.0,
  "buffer_font_size": 13,
  "theme": "Blacklight Focus Dim Ember (Transparent)",
  "languages": {
    "Rust": {
      "semantic_tokens": "combined"
    }
  },
  "global_lsp_settings": {
    "semantic_token_rules": [
      { "token_type": "enumMember", "style": ["variant"] },
      { "token_type": "macro", "token_modifiers": ["declaration"], "style": ["function.special.definition"] },
      { "token_type": "macro", "style": ["function.special"] },
      { "token_type": "function", "token_modifiers": ["declaration"], "style": ["function.definition"] },
      { "token_type": "method", "token_modifiers": ["declaration"], "style": ["function.definition"] },
      { "token_type": "function", "style": ["function"] },
      { "token_type": "method", "style": ["function.method"] },
      { "token_type": "attribute", "style": ["attribute"] },
      { "token_type": "attributeBracket", "style": ["attribute"] },
      { "token_type": "derive", "style": ["attribute"] },
      { "token_type": "lifetime", "style": ["lifetime"] },
      { "token_type": "selfKeyword", "style": ["variable.special"] },
      { "token_type": "selfTypeKeyword", "style": ["type"] },
      { "token_type": "builtinType", "style": ["type.builtin"] },
      { "token_type": "typeAlias", "style": ["type"] },
      { "token_type": "interface", "style": ["type.interface"] },
      { "token_type": "namespace", "style": ["namespace"] },
      { "token_type": "property", "style": ["property"] },
      { "token_type": "parameter", "style": ["variable.parameter"] },
      { "token_type": "boolean", "style": ["boolean"] },
      { "token_type": "punctuation", "style": ["punctuation"] },
      { "token_type": "operator", "style": ["operator"] }
    ]
  }
}
