[alias]
	a = add
	c = commit
	s = status

[user]
	name = Simon Amadeus
	email = simon.joedicke@code.berlin

[color]
	ui = auto

[commit]
	gpgsign = false

[core]
	autocrlf = input
	editor = helix
	eol = lf

[credential]
	helper = cache --timeout=3600

[diff]
	algorithm = histogram
	colorMoved = default

[merge]
	conflictstyle = zdiff3

[init]
	defaultBranch = trunk

[pull]
	rebase = true

[push]
	default = simple

[tag]
	forceSignAnnotated = false

